    {
      "parameters": {
        "jsCode": "// Data mining: cleaning, normalization, validation, dedup, quality scoring\nconst clean = (v) => String(v || '').replace(/\\s+/g, ' ').trim();\nconst junk = /^(n\\/a|na|none|null|undefined|غير متوفر|غير معروف|لا يوجد|-)$/i;\nconst val = (v) => { const c = clean(v); return junk.test(c) ? '' : c; };\n\nfunction normPhone(raw) {\n  let d = String(raw || '').replace(/[^0-9]/g, '');\n  if (d.startsWith('00966')) d = d.slice(5);\n  else if (d.startsWith('966')) d = d.slice(3);\n  if (d.startsWith('0')) d = d.slice(1);\n  return /^5\\d{8}$/.test(d) ? '+966' + d : '';\n}\n\nconst platforms = {\n  instagram: /^https?:\\/\\/(www\\.)?instagram\\.com\\/[A-Za-z0-9_.]+/i,\n  twitter: /^https?:\\/\\/(www\\.)?(twitter|x)\\.com\\/[A-Za-z0-9_]+/i,\n  snapchat: /^https?:\\/\\/(www\\.)?snapchat\\.com\\/add\\/[A-Za-z0-9_.\\-]+/i,\n  tiktok: /^https?:\\/\\/(www\\.)?tiktok\\.com\\/@[A-Za-z0-9_.]+/i,\n  facebook: /^https?:\\/\\/(www\\.|m\\.)?facebook\\.com\\/[A-Za-z0-9_.\\-]+/i,\n};\nconst labels = { instagram: 'Instagram', twitter: 'X', snapchat: 'Snapchat', tiktok: 'TikTok', facebook: 'Facebook' };\n\nfunction normUrl(u) {\n  let s = val(u);\n  if (!s) return '';\n  if (!/^https?:\\/\\//i.test(s)) s = 'https://' + s.replace(/^\\/+/, '');\n  return s.split('?')[0].replace(/\\/+$/, '');\n}\n\nconst seenPhones = new Set();\nconst seenSites = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const storeUrl = normUrl(j.url);\n  const host = storeUrl.replace(/^https?:\\/\\//i, '').replace(/^www\\./i, '').split('/')[0].toLowerCase();\n  const phone = normPhone(j.phone);\n  const socials = [];\n  for (const k of Object.keys(platforms)) {\n    const u = normUrl(j[k]);\n    if (u && platforms[k].test(u)) socials.push(labels[k] + ': ' + u);\n  }\n  const storeName = val(j.store_name) || host;\n  const ownerName = val(j.owner_name);\n\n  // Deduplicate by website and by phone\n  if (!host || seenSites.has(host)) continue;\n  if (phone && seenPhones.has(phone)) continue;\n\n  // Completeness score (0-100)\n  let score = 0;\n  if (val(j.store_name)) score += 25;\n  if (ownerName) score += 15;\n  if (phone) score += 35;\n  if (socials.length) score += 25;\n\n  const valid = !!storeName && (!!phone || socials.length > 0);\n  if (!valid) continue;\n\n  seenSites.add(host);\n  if (phone) seenPhones.add(phone);\n  out.push({ json: {\n    store_name: storeName,\n    owner_name: ownerName,\n    phone: phone,\n    socials: socials.join('\\n'),\n    store_url: storeUrl,\n    quality_score: score,\n  } });\n}\nout.sort((a, b) => b.json.quality_score - a.json.quality_score);\nreturn out;"
      },
