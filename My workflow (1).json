    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  let results = [];\n  if (j.web && Array.isArray(j.web.results)) results = j.web.results;\n  else if (Array.isArray(j.results)) results = j.results;\n  else if (j.url) results = [j];\n  for (const r of results) {\n    if (!r || !r.url) continue;\n    const m = String(r.url).match(/^https?:\\/\\/([^\\/?#]+)/i);\n    if (!m) continue;\n    const host = m[1].toLowerCase().replace(/^www\\./, '');\n    if (seen.has(host)) continue;\n    seen.add(host);\n    out.push({ json: { title: r.title || '', url: r.url, host: host } });\n  }\n}\nreturn out;"
      },
